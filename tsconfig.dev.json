// The configuration `bun run typecheck` reads. It is not named tsconfig.json: PocketJS's compiler
// inherits a project root's tsconfig.json when it checks the applet, and this one names packages
// (bun-types, vendor/pocketjs's) that are not there where this repository is vendored beside PocketJS.
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["bun-types"],
    "typeRoots": ["./vendor/pocketjs/node_modules/@types", "./vendor/pocketjs/node_modules"],
    "baseUrl": ".",
    "paths": {
      "solid-js": ["./vendor/pocketjs/node_modules/solid-js"],
      "@pocketjs/framework": ["./vendor/pocketjs/framework/src/index.ts"],
      "@pocketjs/framework/solid": ["./vendor/pocketjs/framework/src/index.ts"],
      "@pocketjs/framework/input": ["./vendor/pocketjs/framework/src/input-api.ts"],
      "@pocketjs/framework/lifecycle": ["./vendor/pocketjs/framework/src/lifecycle.ts"],
      "@pocketjs/framework/*": ["./vendor/pocketjs/framework/src/*"]
    }
  },
  "include": ["app", "service", "tools", "test", "protocol.ts", "vendor/pocketui/src", "vendor/pocketjs/framework/src/jsx.d.ts"]
}
